{{!
    @template block_maristtela/report_page

    Este template renderiza o formulário da página de relatório

    Exemplo de contexto (json):
    {
        "courseid": int, o ID do curso que estamos visualizando
        "link": string, a URL para a ação do formulário
        "user": string, o valor do campo do usuário
        "starttime": string, o valor do campo de hora de início
        "endtime": string, o valor do campo de hora de término
    }
}}

<form class="block_maristtela" method="GET" action="{{link}}" role="search" aria-label="Filtro de relatório Maristtela" style="max-width: 600px; margin: 1rem auto; padding: 1.5rem; background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgb(0 0 0 / 0.1);">
    <input type="hidden" name="courseid" value="{{courseid}}" />
    <div class="report_container" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
        <div style="flex: 1 1 45%; display: flex; flex-direction: column;">
            <label for="user" style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.4rem; color: #333;">Buscar por nome de usuário</label>
            <input id="user" name="user" type="text" value="{{user}}" placeholder="Nome do usuário" autocomplete="off" 
                style="padding: 0.5rem 0.75rem; font-size: 1rem; border-radius: 6px; border: 1.5px solid #ccc; transition: border-color 0.3s ease;">
        </div>
        <div style="flex: 1 1 25%; display: flex; flex-direction: column;">
            <label for="starttime" style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.4rem; color: #333;">Hora de início</label>
            <input id="starttime" type="datetime-local" name="starttime" value="{{starttime}}"
                style="padding: 0.5rem 0.75rem; font-size: 1rem; border-radius: 6px; border: 1.5px solid #ccc; transition: border-color 0.3s ease;">
        </div>
        <div style="flex: 1 1 25%; display: flex; flex-direction: column;">
            <label for="endtime" style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.4rem; color: #333;">Hora de término</label>
            <input id="endtime" type="datetime-local" name="endtime" value="{{endtime}}"
                style="padding: 0.5rem 0.75rem; font-size: 1rem; border-radius: 6px; border: 1.5px solid #ccc; transition: border-color 0.3s ease;">
        </div>
    </div>
    <button class="btn btn-primary" type="submit" style="font-weight: 700; font-size: 1rem; padding: 0.5rem 1.25rem; border-radius: 8px; min-width: 130px; transition: background-color 0.3s ease;">
        Buscar
    </button>
</form>

<style>
    form.block_maristtela input:focus {
        border-color: #4caf50 !important;
        box-shadow: 0 0 6px #4caf50aa !important;
        outline: none !important;
    }

    form.block_maristtela button.btn-primary:hover,
    form.block_maristtela button.btn-primary:focus {
        background-color: #388e3c !important;
        outline: none !important;
        box-shadow: 0 0 12px #388e3caa !important;
    }

    @media (max-width: 480px) {
        form.block_maristtela {
            padding: 1rem 1rem 1.5rem 1rem;
            max-width: 100%;
        }
        form.block_maristtela .report_container > div {
            flex: 1 1 100% !important;
        }
        form.block_maristtela button.btn-primary {
            width: 100%;
            min-width: unset;
        }
    }
</style>
